# Copy to .env and fill in. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated backups tried if the primary model is overloaded or retired
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
PORT=8080
# Set to true when running behind a trusted proxy/load balancer (e.g. Cloud Run)
TRUST_PROXY=false
