{
  "name": "airwise",
  "version": "1.0.0",
  "description": "AirWise – a GenAI urban air-quality assistant that builds personalised, low-emission daily plans for families during winter smog.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
